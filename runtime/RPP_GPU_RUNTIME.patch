+
+enum class llama_rpp_gpu_transfer_state {
+    missing,
+    queued,
+    running,
+    done,
+    failed,
+};
+
+struct llama_rpp_gpu_transfer_snapshot {
+    llama_rpp_gpu_transfer_state state = llama_rpp_gpu_transfer_state::missing;
+    uint64_t bytes = 0;
