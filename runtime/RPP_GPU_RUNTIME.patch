+
+        assert(llama_rpp_runtime::eval_callback(&tensor, true, &runtime));
+        assert(llama_rpp_runtime::eval_callback(&tensor, false, &runtime));
+        runtime.end_ubatch();
+    }
+
+    std::ifstream trace(trace_path);
+    assert(trace.is_open());
+    std::string line0;
+    std::string line1;
+    assert(std::getline(trace, line0));
